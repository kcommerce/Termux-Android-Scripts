#!/usr/bin/env python3
"""
Edge TTS Speak - Standalone Command Line Speech Synthesizer for Termux
========================================================================
Uses Microsoft Edge Neural Text-to-Speech API to synthesize crystal-clear
natural speech and plays it via termux-media-player.

Usage:
  edge-tts-speak "ข้อความที่ต้องการพูด"
  edge-tts-speak -v th-TH-NiwatNeural "ข้อความเสียงผู้ชาย"
  edge-tts-speak -v th-TH-PremwadeeNeural -r "+10%" -o /path/to/save.mp3 "ข้อความที่ต้องการ"
"""

import sys
import os
import argparse
import asyncio
import subprocess
import shutil

def main():
    parser = argparse.ArgumentParser(description="Termux Edge Neural Text-to-Speech Synthesizer")
    parser.add_argument("text", nargs="?", help="Text to speak")
    parser.add_argument("-v", "--voice", default="th-TH-PremwadeeNeural", help="Voice model (default: th-TH-PremwadeeNeural)")
    parser.add_argument("-r", "--rate", default="+0%", help="Speaking rate adjustment e.g. +10%%, -20%% (default: +0%%)")
    parser.add_argument("-o", "--output", help="Save synthesized MP3 to file instead of temporary file")
    parser.add_argument("--no-play", action="store_true", help="Do not play audio file after synthesis")
    parser.add_argument("-l", "--lang", help="Language shorthand (e.g. 'th' maps to th-TH-PremwadeeNeural)")
    parser.add_argument("-e", "--engine", help="Ignored for backward compatibility with termux-tts-speak arguments")
    parser.add_argument("-p", "--pitch", help="Ignored for backward compatibility with termux-tts-speak arguments")

    args = parser.parse_args()

    if not args.text:
        if not sys.stdin.isatty():
            args.text = sys.stdin.read().strip()
        else:
            parser.print_help()
            sys.exit(1)

    if not args.text:
        print("Error: No text provided.", file=sys.stderr)
        sys.exit(1)

    # Shorthand language mapping
    if args.lang:
        lang_lower = args.lang.lower()
        if lang_lower == "th":
            args.voice = "th-TH-PremwadeeNeural"
        elif lang_lower == "en":
            args.voice = "en-US-AvaNeural"

    # Handle rate format if user passes floating numbers e.g. 0.8 or 1.2
    rate_str = str(args.rate).strip()
    try:
        rate_float = float(rate_str)
        # Convert floating multiplier (e.g. 0.8 -> -20%, 1.2 -> +20%)
        pct = int(round((rate_float - 1.0) * 100))
        rate_str = f"{'+' if pct >= 0 else ''}{pct}%"
    except ValueError:
        if not rate_str.endswith("%"):
            rate_str = "+0%"

    voice = args.voice
    text = args.text.strip('"').strip("'")

    # Determine output file path
    if args.output:
        output_file = os.path.abspath(args.output)
    else:
        cache_dir = os.path.join(os.path.expanduser("~"), ".config", "eldercare", "sounds")
        os.makedirs(cache_dir, exist_ok=True)
        output_file = os.path.join(cache_dir, "tts_cli_output.mp3")

    try:
        import edge_tts
        async def _synth():
            communicate = edge_tts.Communicate(text, voice, rate=rate_str)
            await communicate.save(output_file)

        asyncio.run(_synth())
    except Exception as e:
        print(f"Error synthesizing speech with edge-tts: {e}", file=sys.stderr)
        # Fallback to local termux-tts-speak if available
        if shutil.which("termux-tts-speak"):
            print("Falling back to termux-tts-speak...", file=sys.stderr)
            subprocess.run(["termux-tts-speak", "-l", "th", text])
            sys.exit(0)
        else:
            sys.exit(1)

    if not args.no_play and not args.output:
        # Stop any currently playing media player track and play the new speech audio
        subprocess.run(["termux-media-player", "stop"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        res = subprocess.run(["termux-media-player", "play", output_file])
        if res.returncode != 0 and shutil.which("mpv"):
            subprocess.run(["mpv", "--no-video", output_file])

if __name__ == "__main__":
    main()
